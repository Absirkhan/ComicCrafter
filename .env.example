# ComicCrafter Environment Configuration
# Copy this file to .env and fill in your API keys

# === LLM API Keys ===
# Groq API Key (Primary LLM - Llama 3.3 70B)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Alternative LLM)
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# === Image Generation ===
# HuggingFace API Token (For FLUX/Stable Diffusion)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# === Model Configuration ===
# LLM Model (Groq models: llama-3.3-70b-versatile, llama-3.1-70b-versatile)
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# Image Model (HuggingFace models)
DEFAULT_IMAGE_MODEL=black-forest-labs/FLUX.1-dev

# Gemini Model Version
GEMINI_MODEL=gemini-2.0-flash-exp

# === Storage Configuration ===
# Path for ChromaDB vector store
CHROMADB_PATH=./data/chroma_db

# ChromaDB collection name
CHROMADB_COLLECTION=comic_characters

# === Output Configuration ===
# Directory for generated comics
OUTPUT_DIR=./output

# Maximum panels per comic page
MAX_PANELS_PER_PAGE=6

# Generated image dimensions
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
